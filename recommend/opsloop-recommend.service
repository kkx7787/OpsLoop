[Unit]
Description=OpsLoop AI 판정 추천 (판정 대기 사건 → 추천 표. 판정과 차단은 사람이 한다)
Wants=network-online.target
# 터널이 없거나 학교 밖이면 작업기가 닿지 않음을 상태 한 행에 남기고 0 으로 끝난다(장애가 아니다)
After=network-online.target docker.service opsloop-ai-tunnel.service

[Service]
Type=oneshot
User=opsloop-ai
Group=opsloop-ai
# 터널 끝 주소 · 모델 · 회당 상한만. DB 접속(DATABASE_URL)은 작업기가 /etc/opsloop/ai.env 에서 직접 읽는다
EnvironmentFile=/etc/default/opsloop-recommend
ExecStart=/usr/local/bin/opsloop-recommend run
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
# 근거는 사건마다 수 KB(명령 10줄 · 웹 요청 8줄 · 규칙 근거 3000자 상한)라 작다
MemoryMax=256M
# 회당 10건 × (최대 120초 × 두 번). 연속 두 번 실패하면 멈추므로 실제로는 훨씬 짧다
TimeoutStartSec=45min
