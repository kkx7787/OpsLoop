[Unit]
Description=OpsLoop 관제 대상 로그 다리 (Loki · 관문 원장 → events, 자기 탐지)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target docker.service

[Service]
Type=oneshot
User=opsloop-pull
Group=opsloop-pull
# OPSLOOP_HOME 등. DB 접속 정보는 다리가 /etc/opsloop/collector.env 에서 직접 읽는다 (셸로 읽지 않는다)
EnvironmentFile=/etc/default/opsloop-ingest
ExecStart=/usr/bin/python3 /opt/opsloop/app/collector/pull_loki.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/opsloop
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
MemoryMax=256M
# 탐지기가 메모리 상한에 걸려 죽어도 다리는 살아서 실패로 끝낸다
OOMPolicy=continue
# 최악: Loki 읽기 180초 + 원장 + 탐지 2회 × 240초. 넘겨서 죽어도 상태는 쪽마다 저장돼 있다
TimeoutStartSec=900
