[Unit]
Description=OpsLoop 원장 가져오기 · 적재 · 탐지 (안에서 밖으로만 연결한다)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target docker.service

[Service]
Type=oneshot
User=opsloop-pull
Group=opsloop-pull
EnvironmentFile=/etc/default/opsloop-ingest
ExecStart=/usr/local/bin/opsloop-ingest
# 구멍(종료 코드 10)도 실패로 남겨 systemctl --failed 에 드러나게 한다
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/opsloop
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
MemoryMax=512M
TimeoutStartSec=900
