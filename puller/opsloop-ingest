#!/usr/bin/env python3
"""데이터 노드 적재 한 회차: 원장 가져오기 → 파싱 → 탐지 (WBS 3.4).

opsloop-ingest.service 가 opsloop-pull 사용자로 5분마다 돌린다.

  1. 가져오기   puller/pull.py. S3 읽기 키는 이 하위 프로세스에만 넘긴다 (파서 · 탐지기는 키를 보지 못한다)
  2. 적재       받은 편지함의 조각을 묶음(200개 · 32MiB)씩 파서에 넘기고, 성공한 묶음만 편지함에서 뺀다.
                묶음이 실패하면 한 파일씩 다시 넣어 보고, 그래도 실패하는 파일만 격리함(quarantine)으로 옮긴다.
                한 파일 때문에 나머지 적재와 탐지가 멈추지 않게 하기 위해서다.
                격리함은 매 회차 한 번씩 다시 시도한다 (DB 가 잠깐 끊겨 격리된 파일은 저절로 돌아온다).
  3. 탐지       원장에 구멍(10)이 있거나 가져오기가 실패했으면 보류한다.

종료 코드 (여러 개면 앞의 것)
   1  가져오기 · DB 접속 · 탐지 실패
  10  원장 구멍. 적재는 했고 탐지는 보류했다
  12  격리된 파일이 있다. 적재 · 탐지는 했다
  13  디스크 여유 부족으로 받기를 멈췄다
  11  생존 신호가 없거나 오래됐다 (센서 업로더가 멈췄을 수 있다)
   0  정상

사용
  opsloop-ingest            한 회차
  opsloop-ingest --full     미러 전체를 편지함에 다시 걸고 적재한다. DB 를 백업에서 복원한 뒤 쓴다
                            (line_hash 로 중복 없이 빠진 부분만 들어간다)
"""
import argparse
import os
import subprocess
import sys

APP = os.environ.get("OPSLOOP_APP", "/opt/opsloop/app")
HOME = os.environ.get("OPSLOOP_HOME", "/var/lib/opsloop")
S3_ENV = os.environ.get("OPSLOOP_S3_ENV", "/etc/opsloop/s3-pull.env")
DB_ENV = os.environ.get("OPSLOOP_DB_ENV", "/etc/opsloop/collector.env")
SENSORS = ("cowrie", "decoy")
BATCH_FILES, BATCH_BYTES = 200, 32 * 1024 * 1024
PULL_OK = (0, 10, 11, 13)

_JOURNAL = bool(os.environ.get("JOURNAL_STREAM"))


def log(msg, level=6):
    print(f"<{level}>{msg}" if _JOURNAL else msg, flush=True)


def read_env(path):
    """KEY=VALUE 파일. 셸로 읽지 않는다 (값에 셸 문자가 있어도 실행되지 않는다)."""
    out = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip()
    return out


def base_env():
    keep = ("PATH", "LANG", "LC_ALL", "JOURNAL_STREAM", "AWS_DEFAULT_REGION")
    env = {k: v for k, v in os.environ.items() if k in keep or k.startswith("OPSLOOP_")}
    env.setdefault("PATH", "/usr/bin:/bin")
    return env


def pull():
    env = base_env()
    env.update(read_env(S3_ENV))
    return subprocess.run([sys.executable, os.path.join(APP, "puller", "pull.py")], env=env).returncode


def relink_all():
    """미러 전체를 편지함에 다시 건다 (--full)."""
    n = 0
    root = os.path.join(HOME, "raw", "v1")
    for sensor in SENSORS:
        box = os.path.join(HOME, "inbox", sensor)
        os.makedirs(box, exist_ok=True)
        base = os.path.join(root, f"sensor={sensor}")
        for dirpath, _dirs, files in os.walk(base):
            for name in files:
                if name.startswith(".") or not name.endswith(".jsonl"):
                    continue
                src = os.path.join(dirpath, name)
                rel = os.path.relpath(src, base).split(os.sep)   # host=<h>/ino=<i>.g<g>/<s>-<e>.jsonl
                if len(rel) != 3:
                    continue
                host, ig = rel[0].split("=", 1)[1], rel[1].split("=", 1)[1]
                ino, gen = ig.split(".g", 1)
                dst = os.path.join(box, f"{host}.{ino}.g{gen}.{name}")
                tmp = os.path.join(box, f".{os.path.basename(dst)}.tmp")
                if os.path.lexists(tmp):
                    os.unlink(tmp)
                os.link(src, tmp)
                os.replace(tmp, dst)
                n += 1
    log(f"미러 전체 {n}개를 편지함에 다시 걸었다")


def db_ok(env):
    code = "import os,psycopg2; psycopg2.connect(os.environ['DATABASE_URL'], connect_timeout=10).close()"
    return subprocess.run([sys.executable, "-c", code], env=env,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def parse(sensor, files, env):
    r = subprocess.run([sys.executable, os.path.join(APP, "parser", f"parse_{sensor}.py"),
                        "--load", "--files-from", "-"],
                       input="".join(p + "\n" for p in files), text=True, env=env, cwd=APP)
    return r.returncode == 0


def listing(d):
    try:
        return sorted(e.path for e in os.scandir(d)
                      if e.is_file(follow_symlinks=False) and not e.name.startswith(".") and e.name.endswith(".jsonl"))
    except FileNotFoundError:
        return []


def batches(files):
    cur, size = [], 0
    for p in files:
        n = os.path.getsize(p)
        if cur and (len(cur) >= BATCH_FILES or size + n > BATCH_BYTES):
            yield cur
            cur, size = [], 0
        cur.append(p)
        size += n
    if cur:
        yield cur


def unlink_all(files):
    for p in files:
        try:
            os.unlink(p)
        except FileNotFoundError:
            pass


def load_sensor(sensor, env):
    """한 센서의 편지함을 적재한다. 격리함에 남은 파일 수를 돌려준다."""
    box = os.path.join(HOME, "inbox", sensor)
    qdir = os.path.join(box, "quarantine")

    # 격리함부터 한 파일씩 다시 시도한다
    for p in listing(qdir):
        if parse(sensor, [p], env):
            os.unlink(p)
            log(f"{sensor} 격리 해제 {os.path.basename(p)}")

    for group in batches(listing(box)):
        if parse(sensor, group, env):
            unlink_all(group)
            continue
        log(f"{sensor} 묶음 {len(group)}개 적재 실패. 한 파일씩 다시 넣는다", 4)
        for p in group:
            if parse(sensor, [p], env):
                os.unlink(p)
            else:
                os.makedirs(qdir, exist_ok=True)
                os.replace(p, os.path.join(qdir, os.path.basename(p)))
                log(f"{sensor} 적재 실패 파일을 격리했다: {os.path.basename(p)}", 3)
    return len(listing(qdir))


def main():
    ap = argparse.ArgumentParser(description="OpsLoop 원장 가져오기 · 적재 · 탐지 한 회차")
    ap.add_argument("--full", action="store_true", help="미러 전체를 다시 적재한다 (DB 복원 뒤)")
    args = ap.parse_args()

    rc_pull = pull()
    if rc_pull not in PULL_OK:
        log(f"가져오기 실패 (종료 코드 {rc_pull}). 받아 둔 조각만 적재하고 탐지는 보류한다", 3)
    if args.full:
        relink_all()

    env = base_env()
    env.update(read_env(DB_ENV))
    if not db_ok(env):
        log("DB 에 접속하지 못했다. 편지함은 그대로 두고 다음 회차에 다시 한다", 3)
        return 1

    quarantined = sum(load_sensor(s, env) for s in SENSORS)
    if quarantined:
        log(f"격리된 파일 {quarantined}개. inbox/<센서>/quarantine 을 확인한다", 3)

    detect_failed = False
    if rc_pull == 10:
        log("원장 구멍: 탐지 보류", 3)
    elif rc_pull in PULL_OK:
        r = subprocess.run([sys.executable, os.path.join(APP, "detector", "detect.py"), "--run"], env=env, cwd=APP)
        detect_failed = r.returncode != 0
        if detect_failed:
            log(f"탐지 실패 (종료 코드 {r.returncode})", 3)

    if rc_pull not in PULL_OK or detect_failed:
        return 1
    for code, bad in ((10, rc_pull == 10), (12, quarantined > 0), (13, rc_pull == 13), (11, rc_pull == 11)):
        if bad:
            return code
    return 0


if __name__ == "__main__":
    sys.exit(main())
